# Used for Alembic migrations / schema setup only (needs DDL + RLS-bypass privileges).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kamla
# Used by the running app (session_factory()/get_db()) for every request.
# Must be the kamla_app role (NOBYPASSRLS) — never a superuser or bypass-capable role.
APP_DATABASE_URL=postgresql+psycopg://kamla_app:CHANGE_ME@localhost:5432/kamla
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_AUDIENCE=YOUR_CLERK_AUDIENCE
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
